# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - NEXODIGITAL
# ==============================================================================
# Copia este archivo como ".env" en la raíz del proyecto y coloca tus datos reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# Usa la External Database URL si vas a conectar desde tu computadora a Render.
# La Internal Database URL de Render solo funciona dentro de la red de Render.
# Si trabajas con PostgreSQL local, deja DATABASE_URL vacío y completa DB_*.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dulce_delicia
DB_USER=postgres
DB_PASSWORD=su_contraseña_aqui
DATABASE_URL=
SECRET_KEY=cambia_esta_clave_aleatoria
FLASK_DEBUG=false
FLASK_ENV=development

# Clave de cifrado de los secretos TOTP (2FA). Mantén el mismo valor entre
# reinicios y despliegues; la aplicación también admite secretos aleatorios
# generados por Render. Para crear una clave Fernet local, usa:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
